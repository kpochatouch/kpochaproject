<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:background="@android:color/black"
  android:paddingTop="10dp"
  android:paddingBottom="10dp"
>

  <!-- Top app bar -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:gravity="center_vertical"
  >

    <TextView
      android:id="@+id/btnHamburger"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="☰"
      android:textSize="22sp"
      android:textColor="@android:color/white"
      android:padding="8dp"
    />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Kpocha"
      android:textStyle="bold"
      android:textSize="20sp"
      android:textColor="@android:color/white"
      android:paddingLeft="6dp"
    />

    <TextView
      android:id="@+id/btnPlus"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="+"
      android:textSize="22sp"
      android:textColor="@android:color/white"
      android:padding="8dp"
    />

    <TextView
      android:id="@+id/btnSearch"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="🔍"
      android:textSize="18sp"
      android:textColor="@android:color/white"
      android:padding="8dp"
    />

    <TextView
      android:id="@+id/btnChat"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="💬"
      android:textSize="18sp"
      android:textColor="@android:color/white"
      android:padding="8dp"
    />

  </LinearLayout>

  <!-- Feed/Reels toggle -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:gravity="center_vertical"
  >

    <TextView
      android:id="@+id/btnModeFeed"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Feed"
      android:textColor="@android:color/black"
      android:background="#F5C542"
      android:paddingLeft="14dp"
      android:paddingRight="14dp"
      android:paddingTop="8dp"
      android:paddingBottom="8dp"
    />

    <TextView
      android:id="@+id/btnModeReels"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Reels"
      android:textColor="@android:color/white"
      android:background="#222222"
      android:paddingLeft="14dp"
      android:paddingRight="14dp"
      android:paddingTop="8dp"
      android:paddingBottom="8dp"
      android:layout_marginLeft="10dp"
    />

  </LinearLayout>

  <!-- Composer row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:gravity="center_vertical"
  >

    <ImageView
      android:id="@+id/avatarMe"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:src="@android:drawable/sym_def_app_icon"
      android:scaleType="centerCrop"
    />

    <TextView
      android:id="@+id/btnComposer"
      android:layout_width="0dp"
      android:layout_height="40dp"
      android:layout_weight="1"
      android:layout_marginLeft="10dp"
      android:background="#1A1A1A"
      android:gravity="center_vertical"
      android:paddingLeft="12dp"
      android:text="What's on your mind?"
      android:textColor="#BBBBBB"
    />

    <TextView
      android:id="@+id/btnPhoto"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="🖼"
      android:textSize="18sp"
      android:textColor="@android:color/white"
      android:padding="10dp"
    />

  </LinearLayout>

  <!-- Stories row (real list, even if empty for now) -->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/storiesRecycler"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:clipToPadding="false"
  />

</LinearLayout>
