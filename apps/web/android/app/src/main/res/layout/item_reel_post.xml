<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black"
>

    <!-- Video -->
    <androidx.media3.ui.PlayerView
    android:id="@+id/playerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:use_controller="false"
    app:resize_mode="fit"
    app:surface_type="surface_view"
  />

    <!-- Poster / thumbnail (video poster OR image post) -->
    <ImageView
    android:id="@+id/imageView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:background="@android:color/black"
    android:visibility="gone"
  />

    <!-- ✅ Spinner centered (RelativeLayout correct rule) -->
    <ProgressBar
    android:id="@+id/loadingSpinner"
    style="?android:attr/progressBarStyleLarge"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_centerInParent="true"
    android:visibility="gone"
  />

    <!-- Top overlay (author + time) -->
    <LinearLayout
    android:id="@+id/topOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#33000000"
  >

        <ImageView
      android:id="@+id/authorAvatar"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:scaleType="centerCrop"
      android:src="@android:drawable/sym_def_app_icon"
    />

        <TextView
      android:id="@+id/authorName"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Author"
      android:textColor="@android:color/white"
      android:textStyle="bold"
      android:layout_marginStart="10dp"
    />

        <TextView
      android:id="@+id/postTime"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text=" • 1h"
      android:textColor="#DDDDDD"
    />
    </LinearLayout>

    <!-- Bottom counts row -->
    <TextView
    android:id="@+id/countsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:padding="12dp"
    android:text="0 likes • 0 comments • 0 shares"
    android:textColor="#CCCCCC"
    android:textSize="12sp"
    android:background="#22000000"
  />

    <!-- Bottom caption sits ABOVE countsRow -->
    <TextView
    android:id="@+id/caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_above="@id/countsRow"
    android:layout_alignParentBottom="true"
    android:padding="12dp"
    android:textColor="@android:color/white"
    android:background="#55000000"
    android:maxLines="3"
  />

       <!-- ✅ Right-side engagement rail -->
    <LinearLayout
    android:id="@+id/actionsRail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_centerVertical="true"
    android:layout_above="@id/caption"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/transparent"
  >

      <include
      android:id="@+id/engagementRail"
      layout="@layout/view_engagement_rail"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
    />

    </LinearLayout>

    <!-- ✅ Tap overlay: covers video area but NOT the right rail (so buttons stay clickable) -->
    <View
    android:id="@+id/tapOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginEnd="90dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@android:color/transparent"
  />

</RelativeLayout>
