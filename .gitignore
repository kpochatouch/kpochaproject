# 🔐 Secrets
serviceAccountKey.json
.env

# Monorepo: ignore env files anywhere
**/.env
**/.env.*

# 📦 Dependencies
node_modules/
apps/*/node_modules/

# 🏗️ Build output & logs
dist/
build/
apps/web/dist/
apps/api/dist/
*.log

# 🧹 System files
.DS_Store
.vscode/

# 🌐 Hosting caches
.vercel/
.render/

# Firebase Android
apps/web/android/app/google-services.json

# 🔐 Android signing secrets
*.keystore
*.jks
apps/web/android/gradle.properties
apps/web/android/keystore.properties

# iOS build output (do not commit)
apps/web/ios/App/build/
apps/web/ios/App/Pods/
apps/web/ios/App/Podfile.lock

# Xcode user state
**/xcuserdata/
**/*.xcuserstate

# Local environment overrides
.env.local
*.env.local

# Vite local env
apps/web/.env.local
apps/api/.env.local

# temp/debug
*.tmp
tmp_*
old.txt

# exports/backups
*.csv
*_backup.json

# routing dumps
table-routing-*